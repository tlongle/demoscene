PORT=5363
PBPX_MODE=selfhosted
ALLOW_REGISTRATION=false
BASE_URL=http://localhost:5363
PBPX_DB_PATH=data/pbpx.db
DEMOPALS_DB_PATH=data/demopals.db
ASSETS_DIR=data/assets

# Optional: Official IGDB / Twitch API Credentials for Box Art
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Admin API Key protection for public/tunnel deployment
ADMIN_API_KEY=

# Optional: Allowed CORS origins (comma-separated, default: *)
CORS_ORIGINS=*