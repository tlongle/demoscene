PORT=5363

# Mode: "selfhosted" (single user / homelab) or "public" (pbpx.cc multi-user archive)
PBPX_MODE=selfhosted

# Multi-user registration (set to true for public web instances)
ALLOW_REGISTRATION=false

# Canonical base URL (used for sharing profile URLs and metadata)
BASE_URL=http://localhost:5363

# Database and media storage paths
PBPX_DB_PATH=data/pbpx.db
DEMOPALS_DB_PATH=data/demopals.db
ASSETS_DIR=data/assets

# Optional: Official IGDB / Twitch API Credentials (self-hosted box art resolution)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Legacy Admin API Key (not required for standard web users)
ADMIN_API_KEY=

# Allowed CORS origins (comma-separated, default: * or https://pbpx.cc)
CORS_ORIGINS=*